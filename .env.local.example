# ========================================
# データベース接続設定
# ========================================
# ローカルで起動したPostgreSQLに接続します
# docker-compose.ymlの設定に合わせてポート5433を指定（ホスト側ポート）
# ※Docker内部から接続する場合はホスト名が変わりますが、これはローカルマシンからアプリを起動する場合の設定です

DB_URL=jdbc:postgresql://localhost:5433/myapp
DB_USER=postgres
DB_PASSWORD=postgres

# Tailscale経由でリモートDBに接続する場合の例（コメントアウト）
# DB_URL=jdbc:postgresql://100.87.27.98:5432/vgm_db_dev
# DB_USER=dev_hayashi
# DB_PASSWORD=pass_yukidayo_617

# ========================================
# Tailscale設定（Docker/Cloud Runのみ）
# ========================================
# これがfalseの場合、Tailscaleを使用せずローカルネットワークでDB接続します
# ローカル開発ではfalseに設定してください
IS_TAILSCALE=false

# ========================================
# サーバーポート設定
# ========================================
PORT=8080

# ========================================
# CORS設定
# ========================================
# フロントエンド（Next.js）のローカル開発サーバーからのアクセスを許可
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ========================================
# メール設定（Gmail使用）
# ========================================
# Googleメール（Gmail）を使用してメール送信します
# アプリパスワードの取得: https://myaccount.google.com/apppasswords
#
# 注意事項:
# - MAIL_USERNAME: Gmailアドレスを指定（送信元メールアドレスとしても使用されます）
# - MAIL_PASSWORD: Googleアプリパスワード（通常のパスワードではありません）
# - MAIL_FROM_NAME: メール送信者名（任意）
#
# application.ymlで smtp.gmail.com:587 が設定されているため、
# MAIL_HOST や MAIL_PORT の環境変数は不要です
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_NAME=GrandMarket

# ========================================
# Firebase認証設定
# ========================================
# ローカル開発では、JSONファイルのパスを指定します
# Cloud Runデプロイ時は、FIREBASE_CREDENTIALS_JSON（Base64エンコード）を使用します
#
# Base64エンコード方法（PowerShell）:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes(".\grandmarket-app-firebase-adminsdk-fbsvc-ce7593aba8.json"))
FIREBASE_CREDENTIALS_PATH=grandmarket-app-firebase-adminsdk-fbsvc-ce7593aba8.json

# Cloud Run用（Base64エンコードされたJSON）
# FIREBASE_CREDENTIALS_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCg...

# ========================================
# メディアサービス設定
# ========================================
# vgm-media（Cloudflare Workers）との通信用JWT秘密鍵
# 256ビット以上の十分に長いランダムな文字列を使用してください
MEDIA_JWT_SECRET=your-256-bit-secret-must-be-very-long-and-secure

# ========================================
# 決済設定（現在未使用）
# ========================================
# 注意: StripeとPayPayの決済機能は実装済みですが、全てコメントアウトされています。
# 理由:
# - StripePaymentService.kt (190行) - 全行コメントアウト
# - PayPayPaymentService.kt (319行) - 全行コメントアウト
# - PayPayHmacAuth.kt (138行) - 全行コメントアウト
#
# 決済機能を有効化する場合は、以下の手順が必要です:
# 1. 上記Kotlinファイルのコメントを解除
# 2. build.gradle.ktsに必要な依存関係を追加（Stripe SDK、WebClient等）
# 3. 以下の環境変数をコメント解除して設定
# 4. application.ymlにStripe/PayPayの設定を追加

# Stripe設定（コメントアウト）
# STRIPE_API_KEY=sk_test_dummy_key
# STRIPE_WEBHOOK_SECRET=whsec_dummy_secret

# PayPay設定（コメントアウト）
# PAYPAY_API_KEY=dummy_api_key
# PAYPAY_API_SECRET=dummy_api_secret
# PAYPAY_MERCHANT_ID=dummy_merchant_id
# PAYPAY_API_BASE_URL=https://stg-api.paypay.ne.jp

# ========================================
# プラットフォーム手数料率（現在未使用）
# ========================================
# 注意: この環境変数はapplication.ymlで定義されていますが、
# 実際のKotlinコード内では使用されていません。
# 将来的にマーケットプレイス機能を実装する際に使用する予定です。
# PLATFORM_FEE_RATE=0.10

